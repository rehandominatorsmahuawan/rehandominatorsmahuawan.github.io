{
  "name": "rehan-dominators-mahuawan",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "NODE_ENV=development node server.ts",
    "build": "vite build",
    "start": "node server.ts",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "web:sync": "npm run build",
    "android:dev": "vite --config vite.android.config.js --host 0.0.0.0 --port 3001",
    "android:ota": "node scripts/build-android-ota.mjs",
    "android:build": "vite build --config vite.android.config.js && node scripts/build-android-ota.mjs",
    "android:sync": "npm run android:build && npx cap sync android"
  },
  "devDependencies": {
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@types/express": "^5.0.6",
    "d3": "^7.9.2",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.1"
  }
}
