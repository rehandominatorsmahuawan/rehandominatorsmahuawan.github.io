rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/Accounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/Accounts/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/Accounts/$(request.auth.uid)).data.active == true;
    }

    match /Accounts/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /TeamPlayers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /Matches/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /News/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /Honours/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /Gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /Socials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /PlayerStats/{id} { allow read: if true; allow write: if isAdmin(); }
    match /Achievements/{id} { allow read: if true; allow write: if isAdmin(); }
    match /PlayingXI/{id} { allow read: if true; allow write: if isAdmin(); }
    match /Availability/{id} {
      allow read: if true;
      allow write: if isAdmin() || (signedIn() && exists(/databases/$(database)/documents/Accounts/$(request.auth.uid)) && get(/databases/$(database)/documents/Accounts/$(request.auth.uid)).data.playerId == id);
    }
    match /TeamRecords/{id} { allow read: if true; allow write: if isAdmin(); }
    match /Tournaments/{id} { allow read: if true; allow write: if isAdmin(); }
    match /Opponents/{id} { allow read: if true; allow write: if isAdmin(); }
    match /Updates/{id} { allow read: if true; allow write: if isAdmin(); }
    match /PlayerProfiles/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }
  }
}
