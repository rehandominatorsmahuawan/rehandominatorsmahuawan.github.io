rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/Accounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/Accounts/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/Accounts/$(request.auth.uid)).data.active == true;
    }

    function optStr(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function optNum(data, key) {
      return !(key in data) || (data[key] is int || data[key] is float);
    }

    function optBool(data, key) {
      return !(key in data) || data[key] is bool;
    }

    function isValidTeamPlayer(data) {
      return data.keys().hasOnly([
        'id', 'name', 'role', 'detail', 'jersey', 'image', 'order', 'active',
        'nick', 'bio', 'socials', 'pass', 'createdMs', 'updatedMs', 'updatedAt'
      ])
      && optStr(data, 'id', 32)
      && optStr(data, 'name', 120)
      && optStr(data, 'role', 120)
      && optStr(data, 'detail', 600)
      && optStr(data, 'jersey', 16)
      && optStr(data, 'image', 960000)
      && optStr(data, 'nick', 120)
      && optStr(data, 'bio', 1600)
      && optNum(data, 'order')
      && optBool(data, 'active');
    }

    function isValidPlayerProfile(data) {
      return data.keys().hasOnly([
        'playerId', 'name', 'role', 'detail', 'jersey', 'nick', 'bio',
        'image', 'socials', 'updatedMs', 'updatedAt'
      ])
      && optStr(data, 'playerId', 32)
      && optStr(data, 'name', 120)
      && optStr(data, 'role', 120)
      && optStr(data, 'detail', 600)
      && optStr(data, 'jersey', 16)
      && optStr(data, 'nick', 120)
      && optStr(data, 'bio', 1600)
      && optStr(data, 'image', 960000)
      && (!('socials' in data) || (data.socials is list && data.socials.size() <= 3))
      && optNum(data, 'updatedMs');
    }

    function isValidMatch(data) {
      return data.keys().hasOnly([
        'opponent', 'matchType', 'date', 'time', 'overs', 'matchStatus', 'status',
        'tossWinner', 'tossDecision', 'venueName', 'venue', 'area', 'district',
        'state', 'latitude', 'longitude', 'venueType', 'pitchType', 'official',
        'tournament', 'note', 'ourScore', 'oppScore', 'ourOvers', 'oppOvers',
        'result', 'margin', 'potm', 'ourWickets', 'oppWickets', 'ourExtras',
        'oppExtras', 'batting', 'bowling', 'partnerships', 'fow',
        'createdMs', 'updatedAt'
      ])
      && optStr(data, 'opponent', 160)
      && optStr(data, 'note', 4000)
      && optStr(data, 'batting', 8000)
      && optStr(data, 'bowling', 8000)
      && optStr(data, 'partnerships', 4000)
      && optStr(data, 'fow', 4000)
      && optNum(data, 'createdMs');
    }

    function isValidNews(data) {
      return data.keys().hasOnly(['title', 'text', 'pinned', 'createdMs', 'updatedAt'])
        && optStr(data, 'title', 240)
        && optStr(data, 'text', 12000)
        && optBool(data, 'pinned')
        && optNum(data, 'createdMs');
    }

    function isValidUpdate(data) {
      return data.keys().hasOnly([
        'category', 'title', 'text', 'date', 'url', 'pinned', 'createdMs',
        'updatedAt', 'done', 'doneAt'
      ])
      && optStr(data, 'category', 64)
      && optStr(data, 'title', 240)
      && optStr(data, 'text', 12000)
      && optStr(data, 'date', 64)
      && optStr(data, 'url', 500)
      && optBool(data, 'pinned')
      && optNum(data, 'createdMs');
    }

    function isValidHonour(data) {
      return data.keys().hasOnly(['year', 'title', 'sub', 'image', 'order', 'createdMs', 'updatedAt'])
        && optStr(data, 'year', 24)
        && optStr(data, 'title', 160)
        && optStr(data, 'sub', 240)
        && optStr(data, 'image', 960000)
        && optNum(data, 'order');
    }

    function isValidGallery(data) {
      return data.keys().hasOnly(['image', 'caption', 'album', 'createdMs', 'updatedAt'])
        && optStr(data, 'image', 960000)
        && optStr(data, 'caption', 400)
        && optStr(data, 'album', 64)
        && optNum(data, 'createdMs');
    }

    function isValidSocial(data) {
      return data.keys().hasOnly(['name', 'displayName', 'url', 'icon', 'image', 'order', 'createdMs', 'updatedAt'])
        && optStr(data, 'name', 64)
        && optStr(data, 'displayName', 120)
        && optStr(data, 'url', 600)
        && optStr(data, 'icon', 32)
        && optStr(data, 'image', 960000)
        && optNum(data, 'order');
    }

    function isValidPlayerStats(data) {
      return data.keys().hasOnly([
        'playerId', 'matches', 'runs', 'wickets', 'highScore', 'bestBowling',
        'fours', 'sixes', 'fifties', 'hundreds', 'runOuts', 'strikeRate',
        'economy', 'ballsFaced', 'last5', 'season', 'updatedAt'
      ])
      && optStr(data, 'playerId', 32)
      && optStr(data, 'bestBowling', 64)
      && optStr(data, 'last5', 240)
      && optStr(data, 'season', 32);
    }

    function isValidAchievement(data) {
      return data.keys().hasOnly(['title', 'playerName', 'detail', 'season', 'createdMs', 'updatedAt'])
        && optStr(data, 'title', 200)
        && optStr(data, 'playerName', 120)
        && optStr(data, 'detail', 1200)
        && optStr(data, 'season', 32)
        && optNum(data, 'createdMs');
    }

    function isValidAvailability(data) {
      return data.keys().hasOnly(['playerId', 'status', 'updatedAt'])
        && data.playerId is string && data.playerId.size() <= 32
        && data.status is string && data.status in ['AVAILABLE', 'UNAVAILABLE', 'NOT SET'];
    }

    function isValidPlayingXI(data) {
      return data.keys().hasOnly(['title', 'match', 'players', 'subs', 'createdMs', 'updatedAt'])
        && optStr(data, 'title', 160)
        && optStr(data, 'match', 200)
        && (!('players' in data) || (data.players is list && data.players.size() <= 15))
        && (!('subs' in data) || (data.subs is list && data.subs.size() <= 15))
        && optNum(data, 'createdMs');
    }

    function isValidTeamRecord(data) {
      return data.keys().hasOnly([
        'recordType', 'category', 'season', 'title', 'value', 'player', 'player2',
        'wicket', 'opponent', 'date', 'note', 'createdMs', 'updatedAt'
      ])
      && optStr(data, 'title', 200)
      && optStr(data, 'value', 160)
      && optStr(data, 'note', 1200)
      && optNum(data, 'createdMs');
    }

    function isValidTournament(data) {
      return data.keys().hasOnly([
        'name', 'season', 'status', 'position', 'startDate', 'endDate', 'dates',
        'organizer', 'teams', 'matches', 'wins', 'losses', 'draws',
        'venueName', 'venue', 'area', 'district', 'state', 'latitude', 'longitude',
        'fixtures', 'createdMs', 'updatedAt'
      ])
      && optStr(data, 'name', 200)
      && optStr(data, 'fixtures', 5000)
      && optNum(data, 'createdMs');
    }

    function isValidOpponent(data) {
      return data.keys().hasOnly(['name', 'played', 'won', 'lost', 'createdMs', 'updatedAt'])
        && optStr(data, 'name', 160)
        && optNum(data, 'played')
        && optNum(data, 'won')
        && optNum(data, 'lost');
    }

    function isValidBrandSettings(data) {
      return data.keys().hasOnly([
        'logo', 'favicon', 'appIcon', 'socialPreview', 'brandVersion',
        'appVersion', 'appVersionCode', 'updateNotes', 'forceUpdate',
        'apkDownloadUrl', 'apkReleasesUrl', 'updatedMs', 'updatedAt'
      ])
      && optStr(data, 'logo', 960000)
      && optStr(data, 'favicon', 960000)
      && optStr(data, 'appIcon', 960000)
      && optStr(data, 'socialPreview', 960000)
      && optStr(data, 'appVersion', 32)
      && optStr(data, 'updateNotes', 2500)
      && optBool(data, 'forceUpdate')
      && optNum(data, 'appVersionCode');
    }

    match /Accounts/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /TeamPlayers/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && (isAdmin() || isValidTeamPlayer(request.resource.data));
      allow delete: if isValidId(id);
    }

    match /PlayerProfiles/{uid} {
      allow read: if true;
      allow create, update: if isValidId(uid) && (isAdmin() || isValidPlayerProfile(request.resource.data));
      allow delete: if isValidId(uid);
    }

    match /Matches/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && (isAdmin() || isValidMatch(request.resource.data));
      allow delete: if isValidId(id);
    }

    match /News/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && (isAdmin() || isValidNews(request.resource.data));
      allow delete: if isValidId(id);
    }

    match /Updates/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && (isAdmin() || isValidUpdate(request.resource.data));
      allow delete: if isValidId(id);
    }

    match /Honours/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && (isAdmin() || isValidHonour(request.resource.data));
      allow delete: if isValidId(id);
    }

    match /Gallery/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && (isAdmin() || isValidGallery(request.resource.data));
      allow delete: if isValidId(id);
    }

    match /Socials/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && (isAdmin() || isValidSocial(request.resource.data));
      allow delete: if isValidId(id);
    }

    match /PlayerStats/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && (isAdmin() || isValidPlayerStats(request.resource.data));
      allow delete: if isValidId(id);
    }

    match /Achievements/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && (isAdmin() || isValidAchievement(request.resource.data));
      allow delete: if isValidId(id);
    }

    match /Availability/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && (isAdmin() || isValidAvailability(request.resource.data));
      allow delete: if isValidId(id);
    }

    match /PlayingXI/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && (isAdmin() || isValidPlayingXI(request.resource.data));
      allow delete: if isValidId(id);
    }

    match /TeamRecords/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && (isAdmin() || isValidTeamRecord(request.resource.data));
      allow delete: if isValidId(id);
    }

    match /Tournaments/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && (isAdmin() || isValidTournament(request.resource.data));
      allow delete: if isValidId(id);
    }

    match /Opponents/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && (isAdmin() || isValidOpponent(request.resource.data));
      allow delete: if isValidId(id);
    }

    match /BrandSettings/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && (isAdmin() || isValidBrandSettings(request.resource.data));
      allow delete: if isValidId(id);
    }
  }
}
